# ---------------------------------------------------------------------------
# Pulse Analytics — environment variables
# Copy this file to `.env` and fill in real values.
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (PostgreSQL / Supabase)
# Use the pooled Prisma URL for runtime (port 6543 / POSTGRES_PRISMA_URL).
DATABASE_URL="postgresql://user:password@localhost:5432/pulse?pgbouncer=true&connection_limit=1"
# Direct (non-pooling) URL for migrations / prisma db push.
DIRECT_URL="postgresql://user:password@localhost:5432/pulse"

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# Stripe
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_PRO_PRICE_ID="price_xxx"
STRIPE_ENTERPRISE_PRICE_ID="price_xxx"

# OpenAI (AI insights)
OPENAI_API_KEY="sk-xxx"
OPENAI_MODEL="gpt-4o"

# Resend (alert emails)
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="Pulse <onboarding@resend.dev>"

# Cron protection (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="a-long-random-string"

# Portfolio / public demo lockdown (set true on shared deploys)
# When true, new accounts are blocked unless listed below.
PORTFOLIO_LOCKDOWN="false"
# Comma-separated emails allowed to create accounts while lockdown is on
PORTFOLIO_ALLOWED_EMAILS=""
